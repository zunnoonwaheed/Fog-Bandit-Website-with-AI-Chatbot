# Vercel → Project → Settings → Environment Variables (Production)
# Must be exactly this name (NOT VITE_* - server-side only)
ANTHROPIC_API_KEY=

# Google Sheets lead collection (server-side only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Contact Form - Website

# Optional automated acknowledgement email for website lead submissions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fog Bandit ANZ <security@banditanz.com.au>
# Comma-separated team recipients. Finance falls back to lead recipients.
LEAD_NOTIFICATION_EMAILS=
FINANCE_NOTIFICATION_EMAILS=

# Supabase authentication (these two values are intentionally browser-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
